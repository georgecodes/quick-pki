[ req ]
default_bits       = 2048
default_md         = sha256
prompt             = no
distinguished_name = dn
req_extensions     = req_ext

[ dn ]
C  = GB
O  = Example Organisation Ltd
OU = Example Software Product
CN = signing.example.org

[ req_ext ]
keyUsage = critical, digitalSignature, nonRepudiation
extendedKeyUsage = @eku
subjectAltName = @san
certificatePolicies = @policies

[ eku ]
# Placeholder private EKU for ecosystem signing.
# Replace with your real signing EKU OID.
eku.1 = 1.3.6.1.4.1.55555.2.1

[ san ]
URI.1 = urn:odtf:finance:gb:fca:participant:123456
URI.2 = urn:odtf:finance:gb:fca:software:9f1c2a3b4c5d

[ policies ]
policyIdentifier = 1.3.6.1.4.1.19273.1.2
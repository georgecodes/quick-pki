<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-cert-api-v1" author="quick-pki">
        <createTable tableName="ca_material">
            <column name="id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="issuer_info_json" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="certificate_pem" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="private_key_ciphertext" type="bytea">
                <constraints nullable="false"/>
            </column>
            <column name="private_key_salt" type="bytea">
                <constraints nullable="false"/>
            </column>
            <column name="private_key_iv" type="bytea">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="issued_certificates">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="serial_number" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="subject_dn" type="varchar(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="certificate_pem" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="chain_pem" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="not_before" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="not_after" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="client_id" type="varchar(256)"/>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="issued_certificates" indexName="idx_issued_certificates_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
